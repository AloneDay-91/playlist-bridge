{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2023"],
    "types": ["node"],
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "baseUrl": ".",
    "paths": {
      "@shared/*": ["src/shared/*"],
      "@/*": ["src/renderer/src/*"],
      "@main/*": ["src/main/*"]
    }
  },
  "include": ["src/shared/**/*", "vite.config.ts", "vite.demo.config.ts", "vitest.config.ts", "tests/**/*"]
}
