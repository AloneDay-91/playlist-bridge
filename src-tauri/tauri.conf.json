{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Playlist Bridge",
  "version": "0.1.0",
  "identifier": "fr.elouanb.playlistbridge",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run vite:dev",
    "beforeBuildCommand": "npm run vite:build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Playlist Bridge",
        "width": 1360,
        "height": 860,
        "minWidth": 1000,
        "minHeight": 640,
        "backgroundColor": "#111111",
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": { "x": 20, "y": 26 },
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
