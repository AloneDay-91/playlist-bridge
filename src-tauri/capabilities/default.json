{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Fenêtre principale : fichiers de l'app, HTTP des API, liens externes.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "core:window:allow-set-focus",
    "opener:default",
    "fs:allow-mkdir",
    "fs:allow-exists",
    "fs:allow-read-text-file",
    "fs:allow-write-text-file",
    {
      "identifier": "fs:scope",
      "allow": [{ "path": "$APPDATA" }, { "path": "$APPDATA/*" }, { "path": "$APPDATA/**" }]
    },
    {
      "identifier": "http:default",
      "allow": [
        { "url": "https://api.spotify.com/**" },
        { "url": "https://accounts.spotify.com/**" },
        { "url": "https://openapi.tidal.com/**" },
        { "url": "https://auth.tidal.com/**" }
      ]
    }
  ]
}
